{
    "mcpServers": {
        "eaos-filesystem": {
            "command": "npx.cmd",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "D:/EAOS"
            ]
        },
        "eaos-postgres": {
            "command": "npx.cmd",
            "args": [
                "-y",
                "@modelcontextprotocol/server-postgres",
                "postgresql://eaos:eaos@localhost:5433/eaos"
            ]
        },
        "eaos-neo4j": {
            "command": "npx.cmd",
            "args": [
                "-y",
                "@modelcontextprotocol/server-neo4j",
                "bolt://localhost:7687",
                "neo4j",
                "password"
            ]
        }
    }
}